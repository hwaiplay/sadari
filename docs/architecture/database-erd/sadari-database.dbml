  ACHV_DATE datetime(6) [note: '목표 달성 확정 일시']
  ANON_YSNO varchar(1) [not null, default: 'N', note: '비식별 참여 여부']
  REGI_DATE datetime(6) [not null, note: '등록 일시']
  UPDT_DATE datetime(6) [not null, note: '수정 일시']

  indexes {
    (CLUB_NUMB, ROND_NUMB, PART_NUMB) [pk]
    (CLUB_NUMB, ROND_NUMB, USER_NUMB) [unique, name: 'UK_TB_CLPART_USER']
    (REPT_NUMB) [unique, name: 'UK_TB_CLPART_REPT']
    (CLUB_NUMB, ROND_NUMB, GOAL_YSNO) [name: 'IX_TB_CLPART_GOAL']
    (USER_NUMB) [name: 'FK_TB_CLPART_USER']
  }
  Note: '독서 모임 회차 참여'
}

Table TH_CLRSLT [headercolor: #D97706] {
  CLUB_NUMB bigint [not null, note: '모임 번호']
  ROND_NUMB bigint [not null, note: '모임별 회차 번호']
  USER_NUMB bigint [not null, note: '결과 확인 대상 사용자 번호']

  ENGL_THIR text [note: '세 번째 영문 콘텐츠 영역']
  CONT_FOUR text [note: '네 번째 콘텐츠 영역']
  ENGL_FOUR text [note: '네 번째 영문 콘텐츠 영역']
  REGI_ADMN varchar(100) [not null, note: '등록 관리자 번호 또는 아이디']
  REGI_DATE datetime [not null, note: '등록 일시']
  UPDT_ADMN varchar(100) [note: '수정 관리자 번호 또는 아이디']
  UPDT_DATE datetime [note: '수정 일시']

  indexes {

  SELT_NUMB bigint [note: '도서 미확정 사유의 선정 번호']
  ELCT_STAT varchar(20) [not null, note: '모임장 선거 상태']
  EXTN_YSNO varchar(1) [not null, default: 'N', note: '선거 기간 연장 여부']
  STRT_DATE datetime(6) [not null, note: '선거 시작 일시']
  ENDX_DATE datetime(6) [not null, note: '선거 마감 일시']
  RSLT_USER bigint [note: '당선 사용자 번호']
  CNFM_ADMN bigint [note: '부재 사유 확정 관리자 번호']
  IDEM_KEYX varchar(64) [not null, note: '선거 생성 멱등키']
  REGI_DATE datetime(6) [not null, note: '등록 일시']

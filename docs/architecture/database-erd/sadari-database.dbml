}

Table TM_CLVOTX [headercolor: #D97706] {
  CLUB_NUMB bigint [not null, note: '모임 번호']
  VOTE_NUMB bigint [not null, note: '모임별 투표 번호']
  VOTE_TYPE varchar(20) [not null, note: '도서 또는 모임장 투표 유형']
  VOTE_ROUN tinyint [not null, default: '1', note: '본선 또는 결선 투표 차수']
  PRNT_VOTE bigint [note: '결선의 원 투표 번호']
  SELT_NUMB bigint [note: '도서 선정 번호']
  ELCT_NUMB bigint [note: '모임장 선거 번호']
  VOTE_TITL varchar(200) [not null, note: '투표 제목 스냅샷']
  VOTE_STAT varchar(20) [not null, note: '투표 상태']
  SECR_YSNO varchar(1) [not null, default: 'Y', note: '비밀투표 여부']
  CHNG_YSNO varchar(1) [not null, default: 'Y', note: '마감 전 투표 변경 허용 여부']
  STRT_DATE datetime(6) [not null, note: '투표 시작 일시']
  ENDX_DATE datetime(6) [not null, note: '투표 마감 일시']
  RSLT_NUMB bigint [note: '선정 도서 또는 당선 사용자 번호']
  CLOS_DATE datetime(6) [note: '투표 종료 일시']
  REGI_DATE datetime(6) [not null, note: '등록 일시']
  UPDT_DATE datetime(6) [not null, note: '수정 일시']

  indexes {
    (CLUB_NUMB, VOTE_NUMB) [pk]
    (CLUB_NUMB, SELT_NUMB, VOTE_ROUN) [unique, name: 'UK_TM_CLVOTX_SELT']
    (CLUB_NUMB, ELCT_NUMB, VOTE_ROUN) [unique, name: 'UK_TM_CLVOTX_ELCT']
    (CLUB_NUMB, PRNT_VOTE) [name: 'IX_TM_CLVOTX_PRNT']
    (CLUB_NUMB, VOTE_TYPE, VOTE_STAT, ENDX_DATE) [name: 'IX_TM_CLVOTX_STAT']
  }
  Note: '독서 모임 공통 투표; CHECK CK_TM_CLVOTX_TYPE: (`VOTE_TYPE` = \'BOOK\' AND `SELT_NUMB` IS NOT NULL AND `ELCT_NUMB` IS NULL) OR (`VOTE_TYPE` = \'OWNER\' AND `SELT_NUMB` IS NULL AND `ELCT_NUMB` IS NOT NULL); CHECK CK_TM_CLVOTX_ROUN: (`VOTE_ROUN` = 1 AND `PRNT_VOTE` IS NULL) OR (`VOTE_ROUN` = 2 AND `PRNT_VOTE` IS NOT NULL); CHECK CK_TM_CLVOTX_SECR: `SECR_YSNO` IN (\'Y\',\'N\'); CHECK CK_TM_CLVOTX_CHNG: `CHNG_YSNO` IN (\'Y\',\'N\'); CHECK CK_TM_CLVOTX_DATE: `ENDX_DATE` > `STRT_DATE`'
}

Table TB_CLVOPT [headercolor: #D97706] {
  CLUB_NUMB bigint [not null, note: '모임 번호']
  VOTE_NUMB bigint [not null, note: '모임별 투표 번호']
  TAGT_NUMB bigint [not null, note: '도서 또는 후보 사용자 대상 번호']
  TAGT_NAME varchar(255) [not null, note: '선택지 표시명 스냅샷']
  OPTI_STAT varchar(20) [not null, note: '투표 선택지 상태']
  REGI_DATE datetime(6) [not null, note: '등록 일시']

  indexes {
    (CLUB_NUMB, VOTE_NUMB, TAGT_NUMB) [pk]
    (CLUB_NUMB, VOTE_NUMB, OPTI_STAT, TAGT_NUMB) [name: 'IX_TB_CLVOPT_STAT']
  }
  Note: '독서 모임 투표 선택지'
}

Table TB_CLVOTR [headercolor: #D97706] {
  CLUB_NUMB bigint [not null, note: '모임 번호']
  VOTE_NUMB bigint [not null, note: '모임별 투표 번호']
  USER_NUMB bigint [not null, note: '투표 시작 시점 유권자 사용자 번호 스냅샷']
  ELIG_YSNO varchar(1) [not null, default: 'Y', note: '현재 투표 자격 여부']
  REGI_DATE datetime(6) [not null, note: '등록 일시']

  indexes {
    (CLUB_NUMB, VOTE_NUMB, USER_NUMB) [pk]
  }
  Note: '독서 모임 투표 유권자 명부; CHECK CK_TB_CLVOTR_ELIG: `ELIG_YSNO` IN (\'Y\',\'N\')'
}

Table TB_CLVBAL [headercolor: #D97706] {
  CLUB_NUMB bigint [not null, note: '모임 번호']
  VOTE_NUMB bigint [not null, note: '모임별 투표 번호']
  USER_NUMB bigint [not null, note: '유권자 사용자 번호 스냅샷']
  TAGT_NUMB bigint [not null, note: '선택한 도서 또는 후보 사용자 대상 번호']
  REGI_DATE datetime(6) [not null, note: '등록 일시']
  UPDT_DATE datetime(6) [not null, note: '수정 일시']

  indexes {
    (CLUB_NUMB, VOTE_NUMB, USER_NUMB) [pk]
    (CLUB_NUMB, VOTE_NUMB, TAGT_NUMB) [name: 'IX_TB_CLVBAL_RSLT']
  }
  Note: '독서 모임 유권자별 투표용지'
}

Table TM_CLRNDX [headercolor: #D97706] {
  CLUB_NUMB bigint [not null, note: '모임 번호']
  ROND_NUMB bigint [not null, note: '모임별 회차 번호']
  BOOK_NUMB bigint [not null, note: '도서 번호']
  ROND_STAT varchar(20) [not null, note: '회차 상태']
  GOAL_STDT datetime(6) [not null, note: '공동 목표 시작 일시']
  GOAL_ENDT datetime(6) [not null, note: '공동 목표 종료 일시']
  OPEN_DATE datetime(6) [note: '독후감 공개 일시']
  COMP_DATE datetime(6) [note: '회차 완료 일시']
  IDEM_KEYX varchar(64) [not null, note: '회차 멱등키']
  REGI_USER bigint [note: '등록 사용자 번호']
  REGI_DATE datetime(6) [not null, note: '등록 일시']
  UPDT_DATE datetime(6) [not null, note: '수정 일시']

  indexes {
    (CLUB_NUMB, ROND_NUMB) [pk]
    (CLUB_NUMB, IDEM_KEYX) [unique, name: 'UK_TM_CLRNDX_IDEM']
    (CLUB_NUMB, ROND_STAT, GOAL_ENDT) [name: 'IX_TM_CLRNDX_STAT']
    (BOOK_NUMB, CLUB_NUMB, ROND_NUMB) [name: 'IX_TM_CLRNDX_BOOK']
    (REGI_USER) [name: 'FK_TM_CLRNDX_REGI']
  }
  Note: '독서 모임 회차'
}

Table TM_CLSELT [headercolor: #D97706] {
  CLUB_NUMB bigint [not null, note: '모임 번호']
  SELT_NUMB bigint [not null, note: '모임별 도서 선정 번호']
  ROND_NUMB bigint [note: '선정 기준 회차 번호']
  BOOK_SELT varchar(20) [not null, note: '도서 선정 상태']
  BOOK_NUMB bigint [note: '최종 선정 도서 번호']
  DUTY_STDT datetime(6) [note: '모임장 도서 확정 책임 시작 일시']
  DUTY_ENDT datetime(6) [note: '모임장 도서 확정 책임 마감 일시']
  PAUS_STDT datetime(6) [note: '책임 기간 일시중지 시작 일시']
  REMA_SECO int [note: '일시중지 시 남은 책임 시간 초']
  SELT_DATE datetime(6) [note: '도서 선정 완료 일시']
  REGI_DATE datetime(6) [not null, note: '등록 일시']
  UPDT_DATE datetime(6) [not null, note: '수정 일시']

  indexes {
    (CLUB_NUMB, SELT_NUMB) [pk]
    (CLUB_NUMB, ROND_NUMB) [unique, name: 'UK_TM_CLSELT_ROND']
    (CLUB_NUMB, BOOK_SELT, DUTY_ENDT) [name: 'IX_TM_CLSELT_DUTY']
    (BOOK_NUMB) [name: 'FK_TM_CLSELT_BOOK']
  }
  Note: '독서 모임 도서 선정 마스터; CHECK CK_TM_CLSELT_REMA: `REMA_SECO` IS NULL OR `REMA_SECO` >= 0'
}

Table TB_CLPART [headercolor: #D97706] {
  CLUB_NUMB bigint [not null, note: '모임 번호']
  ROND_NUMB bigint [not null, note: '모임별 회차 번호']
  PART_NUMB bigint [not null, note: '모임 회차별 참여 번호']
  USER_NUMB bigint [note: '회차 참여 사용자 번호']

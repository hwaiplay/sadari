  SVCI_CNTN mediumtext [not null, note: '정제된 서비스 정보 HTML 본문']
  SVCI_ENCT mediumtext [note: '정제된 서비스 정보 영문 HTML 본문']
  DPLY_YSNO char(1) [not null, default: 'N', note: '현재 배포 여부']
  REGI_ADMN bigint [not null, note: '등록 관리자 번호']
  REGI_DATE datetime [not null, note: '등록 일시']
  UPDT_ADMN bigint [note: '수정 관리자 번호']
  UPDT_DATE datetime [note: '수정 일시']
  DPLY_ADMN bigint [note: '배포 관리자 번호']
  DPLY_DATE datetime [note: '배포 일시']

  indexes {
    (CATE_CGRP, CATE_CODE, VERS_NUMB) [pk]
    (DPLY_YSNO, DPLY_DATE, CATE_CODE, VERS_NUMB) [name: 'IX_CT_SVINFO_DPLY']
  }
  Note: '카테고리별 버전형 서비스 정보'
}

Table CT_POPUPX [headercolor: #2563EB] {
  POPU_SITU varchar(50) [not null, note: '팝업 사용 화면 코드']

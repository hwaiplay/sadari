  RSON_ENNM varchar(100) [note: '피신고자 신고 유형 영문 표시명 스냅샷']
  ACTN_TYPE varchar(30) [not null, note: '신고 조치 유형 코드']
  RPTR_CNTN varchar(1000) [not null, note: '신고자용 처리 결과 내용']
  RPTR_ENCT varchar(1000) [note: '신고자용 영문 처리 결과 내용']
  TGTR_CNTN varchar(1000) [not null, note: '피신고자용 조치 안내 내용']
  TGTR_ENCT varchar(1000) [note: '피신고자용 영문 조치 안내 내용']
  PROC_DATE datetime(6) [not null, note: '신고 조치 완료 일시']

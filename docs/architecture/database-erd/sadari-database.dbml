  ENDX_DATE datetime [note: '종료 예정 일시']
  RLES_DATE datetime [note: '해제 또는 만료 일시']
  RLES_CNTN varchar(1000) [note: '관리자 내부 해제 사유']
  REGI_ADMN decimal(19,0) [not null, note: '등록 관리자 번호 또는 아이디']
  RLES_ADMN decimal(19,0) [note: '해제 관리자 번호']
  REGI_DATE datetime [not null, note: '등록 일시']
  UPDT_ADMN decimal(19,0) [note: '수정 관리자 번호 또는 아이디']
  UPDT_DATE datetime [note: '수정 일시']
  SYNC_STAT varchar(20) [not null, note: '사용자 상태 동기화 상태']
  ACTV_USER bigint [note: '활성 정지 사용자 중복 방지 키; 생성 컬럼']

  indexes {
    (ACTV_USER) [unique, name: 'UK_TH_USSPND_ACTV']
    (USER_NUMB, REGI_DATE, SPND_NUMB) [name: 'IX_TH_USSPND_USER']
    (STRT_DATE, USER_NUMB) [name: 'IX_TH_USSPND_STRT']
  }
  Note: '회원 이용 정지 이력'
}


  MAIN_ENTL varchar(300) [note: '웰컴페이지 영문 제목']
  PAGE_DESC varchar(1000) [not null, note: '웰컴페이지 설명']
  PAGE_ENCT varchar(1000) [note: '웰컴페이지 영문 설명']
  IMGE_URLX varchar(500) [note: '웰컴페이지 이미지 공개 경로']
  IMGE_ENUR varchar(500) [note: '웰컴페이지 영문 이미지 공개 경로']
  SORT_ORDR int [not null, note: '노출 순서']
  DPLY_YSNO char(1) [not null, default: 'N', note: '현재 배포 여부']
  REGI_ADMN bigint [not null, note: '등록 관리자 번호']
  REGI_DATE datetime [not null, note: '등록 일시']
  UPDT_ADMN bigint [note: '수정 관리자 번호']
  UPDT_DATE datetime [note: '수정 일시']
  DPLY_ADMN bigint [note: '배포 관리자 번호']
  DPLY_DATE datetime [note: '배포 일시']

  indexes {
    (WLCM_NUMB, VERS_NUMB) [pk]
    (DPLY_YSNO, SORT_ORDR, WLCM_NUMB, VERS_NUMB) [name: 'IX_CT_WLCMPG_DPLY']
    (WLCM_NUMB, VERS_NUMB) [name: 'IX_CT_WLCMPG_LATEST']
  }
  Note: '버전형 웰컴페이지'
}

Table CT_SVINFO [headercolor: #2563EB] {

Table TH_CMEVDC [headercolor: #DC2626] {
  EVDC_NUMB bigint [pk, not null, increment, note: '신고 증거 번호']
  TAGT_TYPE varchar(20) [not null, note: '신고 대상 유형 세부코드']
  TAGT_NUMB bigint [not null, note: '신고 대상 번호']
  TAGT_HASH char(64) [not null, note: '신고 대상 버전 SHA-256 해시']
  TAGT_USER bigint [note: '신고 대상 소유 사용자 번호']
  ORIG_NAME varchar(500) [note: '증거 원본 파일명']
  MIME_TYPE varchar(200) [not null, note: '증거 파일 MIME 유형']
  FILE_SIZE bigint [not null, note: '증거 파일 크기 바이트']
  EVDC_DATA longblob [not null, note: '비공개 신고 증거 원본 바이트']
  REGI_DATE datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: '등록 일시']

  indexes {
    (TAGT_TYPE, TAGT_NUMB, TAGT_HASH) [unique, name: 'UK_TH_CMEVDC_TAGT_HASH']
    (TAGT_USER, REGI_DATE, EVDC_NUMB) [name: 'IX_TH_CMEVDC_TAGT_USER']
  }
  Note: '관리자 전용 신고 이미지 증거 원본'
}

Table TH_CMPLNT [headercolor: #DC2626] {
  CMPL_NUMB bigint [pk, not null, increment, note: '신고 번호']
  USER_NUMB bigint [note: '신고자 사용자 번호']
  TAGT_TYPE varchar(20) [not null, note: '신고 대상 유형 세부코드']
  TAGT_NUMB bigint [not null, note: '신고 대상 번호']
  TAGT_HASH char(64) [not null, note: '신고 대상 버전 SHA-256 해시']
  TAGT_USER bigint [note: '신고 대상 소유 사용자 번호']
  TAGT_CNTN text [note: '신고 대상 내용 스냅샷']
  EVDC_NUMB bigint [note: '비공개 신고 이미지 증거 번호']
  CMPL_RSON varchar(20) [not null, note: '신고 사유 세부코드']
  CMPL_CNTN varchar(1000) [note: '신고 상세 내용']
  CMPL_STAT varchar(20) [not null, default: 'CMPL_RECEIVED', note: '신고 처리 상태 세부코드']
  PROC_CNTN varchar(1000) [note: '관리자 처리 내용']
  PROC_ADMN bigint [note: '처리 관리자 번호']
  PROC_DATE datetime(6) [note: '처리 일시']
  REGI_DATE datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: '등록 일시']
  UPDT_DATE datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: '수정 일시']

  indexes {
    (USER_NUMB, TAGT_TYPE, TAGT_NUMB, TAGT_HASH) [unique, name: 'UK_TH_CMPLNT_USER_TAGT']
    (TAGT_TYPE, TAGT_NUMB, TAGT_HASH, CMPL_STAT, REGI_DATE) [name: 'IX_TH_CMPLNT_TAGT']
    (TAGT_USER, REGI_DATE, CMPL_NUMB) [name: 'IX_TH_CMPLNT_TAGT_USER']
    (USER_NUMB, REGI_DATE) [name: 'IX_TH_CMPLNT_USER']
    (CMPL_STAT, REGI_DATE, CMPL_NUMB) [name: 'IX_TH_CMPLNT_STAT']
    (PROC_ADMN) [name: 'FK_TH_CMPLNT_PROC']
    (EVDC_NUMB) [name: 'FK_TH_CMPLNT_EVDC']
  }
  Note: '사용자 신고 접수와 처리 이력'
}

Table TH_CMREVT [headercolor: #DC2626] {

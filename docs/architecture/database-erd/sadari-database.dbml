Ref FK_CT_NOTICE_CATE: CT_NOTICE.(CATE_CGRP, CATE_CODE) > TB_CODEXD.(COMM_CODE, COMD_CODE)

Ref FK_CT_SVINFO_CATE: CT_SVINFO.(CATE_CGRP, CATE_CODE) > TB_CODEXD.(COMM_CODE, COMD_CODE)

Ref FK_TM_ALICON_REGI: TM_ALICON.REGI_ADMN > TM_ADMINX.ADMN_NUMB

Ref FK_TM_ALICON_UPDT: TM_ALICON.UPDT_ADMN > TM_ADMINX.ADMN_NUMB

Ref FK_TB_ALIMXX_ALTEMP: TB_ALIMXX.(ALIM_SITU, TEMP_CODE) > TB_ALTEMP.(ALIM_SITU, TEMP_CODE)

Ref FK_TB_ALIMXX_USER: TB_ALIMXX.USER_NUMB > TM_USERXM.USER_NUMB

Ref FK_TB_AUTHMN_AUTH: TB_AUTHMN.AUTH_CODE > TM_AUTHXM.AUTH_CODE

Ref FK_TB_AUTHMN_MENU: TB_AUTHMN.(MENU_NUMB, SUBX_NUMB) > TM_ADMENU.(MENU_NUMB, SUBX_NUMB)


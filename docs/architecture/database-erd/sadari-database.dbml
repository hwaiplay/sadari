Project sadari_database {
  database_type: 'MySQL'
  Note: 'scripts/db/mysql/01-create.sql 기준, SHA-256 edd4a17175cc1d6ba5f9bac58c01211adbf5cf06beed44470f8379d84f2ac728'
}

Table CT_NOTICE [headercolor: #2563EB] {
  NOTI_NUMB bigint [not null, increment, note: '공지사항 주키']
  VERS_NUMB int [not null, note: '공지사항 버전 부키']
  CATE_CGRP varchar(10) [not null, note: '공지사항 카테고리 공통코드']
  CATE_CODE varchar(20) [not null, note: '공지사항 카테고리 상세코드']
  NOTI_TITL varchar(300) [not null, note: '공지사항 제목']
  NOTI_ENTL varchar(300) [note: '공지사항 영문 제목']
  NOTI_CNTN mediumtext [not null, note: '정제된 공지사항 HTML 본문']
  NOTI_ENCT mediumtext [note: '정제된 공지사항 영문 HTML 본문']
  TOPX_YSNO char(1) [not null, default: 'N', note: '상단 고정 여부']
  DPLY_YSNO char(1) [not null, default: 'N', note: '현재 배포 여부']
  REGI_ADMN bigint [not null, note: '등록 관리자 번호']
  REGI_DATE datetime [not null, note: '등록 일시']
  UPDT_ADMN bigint [note: '수정 관리자 번호']
  UPDT_DATE datetime [note: '수정 일시']
  DPLY_ADMN bigint [note: '배포 관리자 번호']
  DPLY_DATE datetime [note: '배포 일시']

  indexes {
    (NOTI_NUMB, VERS_NUMB) [pk]
    (DPLY_YSNO, TOPX_YSNO, DPLY_DATE, NOTI_NUMB, VERS_NUMB) [name: 'IX_CT_NOTICE_DPLY']
    (NOTI_NUMB, VERS_NUMB) [name: 'IX_CT_NOTICE_LATEST']
    (CATE_CGRP, CATE_CODE) [name: 'IX_CT_NOTICE_CATE']
  }
  Note: '버전형 공지사항'
}

Table CT_WLCMPG [headercolor: #2563EB] {
  WLCM_NUMB bigint [not null, increment, note: '웰컴페이지 주키']
  VERS_NUMB int [not null, note: '웰컴페이지 버전 부키']
  SUBX_TITL varchar(200) [not null, note: '웰컴페이지 소제목']
  SUBX_ENTL varchar(200) [note: '웰컴페이지 영문 소제목']

  RSTA_YSNO varchar(1) [not null, default: 'N', note: '독서 통계 공개 여부']
  GOAL_YSNO varchar(1) [not null, default: 'N', note: '독서 목표 공개 여부']
  IMFD_YSNO varchar(1) [not null, default: 'Y', note: '사진 변경 피드 공개 여부']
  RPUB_YSNO varchar(1) [not null, default: 'N', note: '신규 독후감 공개 기본값']
  LKAL_YSNO varchar(1) [not null, default: 'Y', note: '좋아요 알림 사용 여부']
  RPAL_YSNO varchar(1) [not null, default: 'Y', note: '댓글과 답글 알림 사용 여부']
  FOLL_YSNO varchar(1) [not null, default: 'Y', note: '팔로우 알림 사용 여부']
  CLUB_YSNO varchar(1) [not null, default: 'Y', note: '선택형 독서 모임 알림 사용 여부']
  CHAT_YSNO varchar(1) [not null, default: 'Y', note: '독서 모임 채팅 알림 사용 여부']
  RDUE_YSNO varchar(1) [not null, default: 'Y', note: '독후감 목표 종료 알림 사용 여부']
  LKDF_YSNO varchar(1) [not null, default: 'Y', note: '신규 독후감 좋아요 알림 기본값']
  RPDF_YSNO varchar(1) [not null, default: 'Y', note: '신규 독후감 댓글 알림 기본값']
  REGI_DATE datetime(6) [not null, note: '등록 일시']
  UPDT_DATE datetime(6) [not null, note: '수정 일시']
  Note: '회원별 서비스 설정; CHECK CK_TM_USSETX_ENGL: (`ENGL_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_RSTA: (`RSTA_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_GOAL: (`GOAL_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_IMFD: (`IMFD_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_RPUB: (`RPUB_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_LKAL: (`LKAL_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_RPAL: (`RPAL_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_FOLL: (`FOLL_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_CLUB: (`CLUB_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_CHAT: (`CHAT_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_RDUE: (`RDUE_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_LKDF: (`LKDF_YSNO` in (\'Y\',\'N\')); CHECK CK_TM_USSETX_RPDF: (`RPDF_YSNO` in (\'Y\',\'N\'))'
}


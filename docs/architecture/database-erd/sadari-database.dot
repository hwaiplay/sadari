        <TR><TD PORT="TOPX_YSNO" ALIGN="LEFT"><FONT COLOR="#2563EB"><B>[NN]</B></FONT> <B>TOPX_YSNO</B> <FONT COLOR="#64748B">char(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">상단 고정 여부 &#183; DEFAULT &#39;N&#39;</FONT></TD></TR>

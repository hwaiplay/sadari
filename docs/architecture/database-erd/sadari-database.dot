        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#475569"><B>[NN]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">decimal(19,0)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 번호</FONT></TD></TR>
        <TR><TD PORT="SPND_NUMB" ALIGN="LEFT"><FONT COLOR="#475569"><B>[NN]</B></FONT> <B>SPND_NUMB</B> <FONT COLOR="#64748B">decimal(19,0)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">회원 정지 이력 번호</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><FONT COLOR="#475569"><B>[NN]</B></FONT> <B>REGI_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시</FONT></TD></TR>

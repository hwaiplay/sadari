        <TR><TD PORT="PROF_NUMB" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[FK]</B></FONT> <B>PROF_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">프로필 이미지 파일 번호</FONT></TD></TR>

        <TR><TD PORT="SORT_ORDR" ALIGN="LEFT"><B>SORT_ORDR</B> <FONT COLOR="#64748B">decimal(38,10)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">정렬 순서</FONT></TD></TR>
        <TR><TD PORT="SHOW_YSNO" ALIGN="LEFT"><B>SHOW_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">화면 노출 여부</FONT></TD></TR>
        <TR><TD PORT="USEE_YSNO" ALIGN="LEFT"><B>USEE_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용 여부</FONT></TD></TR>
        <TR><TD PORT="REGI_ADMN" ALIGN="LEFT"><FONT COLOR="#2563EB"><B>[FK]</B></FONT> <B>REGI_ADMN</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 관리자 번호 또는 아이디</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><B>REGI_DATE</B> <FONT COLOR="#64748B">datetime(6)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시</FONT></TD></TR>
        <TR><TD PORT="UPDT_ADMN" ALIGN="LEFT"><FONT COLOR="#2563EB"><B>[FK]</B></FONT> <B>UPDT_ADMN</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 관리자 번호 또는 아이디</FONT></TD></TR>
        <TR><TD PORT="UPDT_DATE" ALIGN="LEFT"><B>UPDT_DATE</B> <FONT COLOR="#64748B">datetime(6)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 일시</FONT></TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_user {
    label="사용자 및 보안";
    color="#0F766E";
    penwidth=2;
    style="rounded,dashed";
    margin=24;
    "TB_NKSEQX" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#0F766E" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TB_NKSEQX</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>닉네임 조합별 연월 순번</I></FONT></TD></TR>

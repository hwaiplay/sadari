        <TR><TD PORT="SPND_STAT" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>SPND_STAT</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">회원 정지 처리 상태</FONT></TD></TR>
        <TR><TD PORT="STRT_DATE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>STRT_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">시작 일시</FONT></TD></TR>
        <TR><TD PORT="ENDX_DATE" ALIGN="LEFT"><B>ENDX_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">종료 예정 일시</FONT></TD></TR>

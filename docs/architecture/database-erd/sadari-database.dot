        <TR><TD PORT="NOTI_NUMB" ALIGN="LEFT"><FONT COLOR="#2563EB"><B>[AI, NN]</B></FONT> <B>NOTI_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">공지사항 주키</FONT></TD></TR>

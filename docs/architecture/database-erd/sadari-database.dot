  subgraph cluster_reading {
    label="도서 및 독서";
    color="#7C3AED";
    penwidth=2;
    style="rounded,dashed";
    margin=24;
    "TB_RDATDX" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TB_RDATDX</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>사용자 일별 독서 시간 집계</I></FONT></TD></TR>
        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[FK, NN]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 번호</FONT></TD></TR>
        <TR><TD PORT="READ_DATE" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>READ_DATE</B> <FONT COLOR="#64748B">date</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독서 날짜</FONT></TD></TR>
        <TR><TD PORT="READ_SECS" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>READ_SECS</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확정 독서 시간 초 &#183; DEFAULT 0</FONT></TD></TR>
        <TR><TD PORT="UPDT_DATE" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>UPDT_DATE</B> <FONT COLOR="#64748B">datetime(6)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 일시</FONT></TD></TR>
      </TABLE>
    >];
    "TM_BKINFO" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TM_BKINFO</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>도서 마스터</I></FONT></TD></TR>
        <TR><TD PORT="BOOK_NUMB" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[PK, AI, NN]</B></FONT> <B>BOOK_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 번호</FONT></TD></TR>
        <TR><TD PORT="BOOK_ATHR" ALIGN="LEFT"><B>BOOK_ATHR</B> <FONT COLOR="#64748B">varchar(255)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 저자명</FONT></TD></TR>
        <TR><TD PORT="BOOK_CVIM" ALIGN="LEFT"><B>BOOK_CVIM</B> <FONT COLOR="#64748B">varchar(255)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 표지 이미지 URL</FONT></TD></TR>
        <TR><TD PORT="BOOK_ISBN" ALIGN="LEFT"><B>BOOK_ISBN</B> <FONT COLOR="#64748B">varchar(255)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 ISBN</FONT></TD></TR>
        <TR><TD PORT="BOOK_PUBL" ALIGN="LEFT"><B>BOOK_PUBL</B> <FONT COLOR="#64748B">varchar(255)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 출판사명</FONT></TD></TR>
        <TR><TD PORT="BOOK_TITL" ALIGN="LEFT"><B>BOOK_TITL</B> <FONT COLOR="#64748B">varchar(255)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 제목</FONT></TD></TR>
        <TR><TD PORT="BOOK_DESC" ALIGN="LEFT"><B>BOOK_DESC</B> <FONT COLOR="#64748B">longtext</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 설명</FONT></TD></TR>
        <TR><TD PORT="PUBL_DATE" ALIGN="LEFT"><B>PUBL_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 출간일</FONT></TD></TR>
      </TABLE>
    >];
    "TM_GOALXM" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TM_GOALXM</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>사용자 기간별 독서 목표</I></FONT></TD></TR>
        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[FK, NN]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 번호</FONT></TD></TR>
        <TR><TD PORT="GOAL_DATE" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>GOAL_DATE</B> <FONT COLOR="#64748B">varchar(6)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">목표 적용 기간</FONT></TD></TR>
        <TR><TD PORT="GOAL_TYPE" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>GOAL_TYPE</B> <FONT COLOR="#64748B">varchar(4)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">목표 유형</FONT></TD></TR>
        <TR><TD PORT="GOAL_CNTT" ALIGN="LEFT"><B>GOAL_CNTT</B> <FONT COLOR="#64748B">decimal(38,10)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">목표 독서 권수</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><B>REGI_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시</FONT></TD></TR>
        <TR><TD PORT="UPDT_DATE" ALIGN="LEFT"><B>UPDT_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 일시</FONT></TD></TR>
        <TR><TD PORT="UPDT_CNTT" ALIGN="LEFT"><B>UPDT_CNTT</B> <FONT COLOR="#64748B">decimal(38,0)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">하향 수정 횟수</FONT></TD></TR>
      </TABLE>
    >];
    "TM_REPORT" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TM_REPORT</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>사용자 독후감</I></FONT></TD></TR>
        <TR><TD PORT="REPT_NUMB" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[PK, AI, NN]</B></FONT> <B>REPT_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독후감 번호</FONT></TD></TR>
        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[FK, NN]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 번호</FONT></TD></TR>
        <TR><TD PORT="BOOK_NUMB" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[FK, NN]</B></FONT> <B>BOOK_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 번호</FONT></TD></TR>
        <TR><TD PORT="REPT_STAT" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>REPT_STAT</B> <FONT COLOR="#64748B">text</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독서 상태 코드</FONT></TD></TR>
        <TR><TD PORT="REPT_STDT" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>REPT_STDT</B> <FONT COLOR="#64748B">text</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독서 시작일</FONT></TD></TR>
        <TR><TD PORT="REPT_ENDT" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>REPT_ENDT</B> <FONT COLOR="#64748B">text</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독서 종료일 또는 목표 종료일</FONT></TD></TR>
        <TR><TD PORT="REPT_GRDE" ALIGN="LEFT"><B>REPT_GRDE</B> <FONT COLOR="#64748B">text</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">도서 평점</FONT></TD></TR>
        <TR><TD PORT="REPT_COLR" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>REPT_COLR</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">책장 표시 색상 코드</FONT></TD></TR>
        <TR><TD PORT="REPT_CNTN" ALIGN="LEFT"><B>REPT_CNTN</B> <FONT COLOR="#64748B">text</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독후감 내용</FONT></TD></TR>
        <TR><TD PORT="PUBC_YSNO" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>PUBC_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">공개 여부</FONT></TD></TR>
        <TR><TD PORT="LKAL_YSNO" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>LKAL_YSNO</B> <FONT COLOR="#64748B">char(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독후감 좋아요 알림 여부 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="RPAL_YSNO" ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>[NN]</B></FONT> <B>RPAL_YSNO</B> <FONT COLOR="#64748B">char(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독후감 댓글 알림 여부 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>

digraph sadari_database {
  graph [rankdir=TB, bgcolor="#F8FAFC", pad="0.35", nodesep="0.55", ranksep="1.2", splines=polyline, overlap=false, compound=true, newrank=true, fontname="Malgun Gothic", label="Sadari Database ERD", labelloc=t, fontsize=28];
  node [shape=plain, fontname="Malgun Gothic"];
  edge [color="#94A3B8", fontcolor="#475569", fontname="Malgun Gothic", fontsize=8, penwidth=0.9, arrowsize=0.7, dir=both, arrowtail=crow, arrowhead=tee];
  // DDL SHA-256 edd4a17175cc1d6ba5f9bac58c01211adbf5cf06beed44470f8379d84f2ac728

  subgraph cluster_common {
    label="공통 및 파일";
    color="#64748B";
    penwidth=2;
    style="rounded,dashed";
    margin=24;
    "TB_CODEXD" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#64748B" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TB_CODEXD</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>공통코드 세부 항목</I></FONT></TD></TR>
        <TR><TD PORT="COMM_CODE" ALIGN="LEFT"><FONT COLOR="#64748B"><B>[FK, NN]</B></FONT> <B>COMM_CODE</B> <FONT COLOR="#64748B">varchar(10)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">공통코드</FONT></TD></TR>
        <TR><TD PORT="COMD_CODE" ALIGN="LEFT"><FONT COLOR="#64748B"><B>[NN]</B></FONT> <B>COMD_CODE</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">세부코드</FONT></TD></TR>
        <TR><TD PORT="COMD_NAME" ALIGN="LEFT"><B>COMD_NAME</B> <FONT COLOR="#64748B">varchar(50)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">세부코드 이름</FONT></TD></TR>
        <TR><TD PORT="COMD_ENNM" ALIGN="LEFT"><B>COMD_ENNM</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">세부코드 영문 이름</FONT></TD></TR>
        <TR><TD PORT="CODE_EXPL" ALIGN="LEFT"><B>CODE_EXPL</B> <FONT COLOR="#64748B">varchar(500)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">코드 설명</FONT></TD></TR>
        <TR><TD PORT="UPPR_CODE" ALIGN="LEFT"><FONT COLOR="#64748B"><B>[FK]</B></FONT> <B>UPPR_CODE</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">상위 세부코드</FONT></TD></TR>
        <TR><TD PORT="OPT1_CODE" ALIGN="LEFT"><B>OPT1_CODE</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 1 코드</FONT></TD></TR>
        <TR><TD PORT="OPT1_NAME" ALIGN="LEFT"><B>OPT1_NAME</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 1 이름</FONT></TD></TR>
        <TR><TD PORT="OPT1_ENNM" ALIGN="LEFT"><B>OPT1_ENNM</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 1 영문 이름</FONT></TD></TR>
        <TR><TD PORT="OPT2_CODE" ALIGN="LEFT"><B>OPT2_CODE</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 2 코드</FONT></TD></TR>
        <TR><TD PORT="OPT2_NAME" ALIGN="LEFT"><B>OPT2_NAME</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 2 이름</FONT></TD></TR>
        <TR><TD PORT="OPT2_ENNM" ALIGN="LEFT"><B>OPT2_ENNM</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 2 영문 이름</FONT></TD></TR>
        <TR><TD PORT="OPT3_CODE" ALIGN="LEFT"><B>OPT3_CODE</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 3 코드</FONT></TD></TR>
        <TR><TD PORT="OPT3_NAME" ALIGN="LEFT"><B>OPT3_NAME</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 3 이름</FONT></TD></TR>
        <TR><TD PORT="OPT3_ENNM" ALIGN="LEFT"><B>OPT3_ENNM</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 3 영문 이름</FONT></TD></TR>
        <TR><TD PORT="OPT4_CODE" ALIGN="LEFT"><B>OPT4_CODE</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 4 코드</FONT></TD></TR>
        <TR><TD PORT="OPT4_NAME" ALIGN="LEFT"><B>OPT4_NAME</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 4 이름</FONT></TD></TR>
        <TR><TD PORT="OPT4_ENNM" ALIGN="LEFT"><B>OPT4_ENNM</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">확장 속성 4 영문 이름</FONT></TD></TR>
        <TR><TD PORT="USEE_YSNO" ALIGN="LEFT"><B>USEE_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용 여부</FONT></TD></TR>
        <TR><TD PORT="REGI_ADMN" ALIGN="LEFT"><B>REGI_ADMN</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 관리자 번호 또는 아이디</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><B>REGI_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시</FONT></TD></TR>
        <TR><TD PORT="SORT_ORDR" ALIGN="LEFT"><B>SORT_ORDR</B> <FONT COLOR="#64748B">decimal(38,0)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">정렬 순서</FONT></TD></TR>
        <TR><TD PORT="UPDT_ADMN" ALIGN="LEFT"><B>UPDT_ADMN</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 관리자 번호 또는 아이디</FONT></TD></TR>
        <TR><TD PORT="UPDT_DATE" ALIGN="LEFT"><B>UPDT_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 일시</FONT></TD></TR>
      </TABLE>
    >];
    "TM_CODEXM" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#64748B" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TM_CODEXM</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>공통코드 그룹</I></FONT></TD></TR>
        <TR><TD PORT="COMM_CODE" ALIGN="LEFT"><FONT COLOR="#64748B"><B>[PK, NN]</B></FONT> <B>COMM_CODE</B> <FONT COLOR="#64748B">varchar(10)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">공통코드</FONT></TD></TR>
        <TR><TD PORT="CODE_NAME" ALIGN="LEFT"><B>CODE_NAME</B> <FONT COLOR="#64748B">varchar(50)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">공통코드 이름</FONT></TD></TR>
        <TR><TD PORT="CODE_EXPL" ALIGN="LEFT"><B>CODE_EXPL</B> <FONT COLOR="#64748B">varchar(500)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">코드 설명</FONT></TD></TR>
        <TR><TD PORT="USEE_YSNO" ALIGN="LEFT"><B>USEE_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용 여부</FONT></TD></TR>
        <TR><TD PORT="REGI_ADMN" ALIGN="LEFT"><B>REGI_ADMN</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 관리자 번호 또는 아이디</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><B>REGI_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시</FONT></TD></TR>
        <TR><TD PORT="UPDT_ADMN" ALIGN="LEFT"><B>UPDT_ADMN</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 관리자 번호 또는 아이디</FONT></TD></TR>
        <TR><TD PORT="UPDT_DATE" ALIGN="LEFT"><B>UPDT_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 일시</FONT></TD></TR>
      </TABLE>
    >];
    "TM_FILEXM" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#64748B" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TM_FILEXM</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>업로드 파일 메타 정보</I></FONT></TD></TR>
        <TR><TD PORT="FILE_NUMB" ALIGN="LEFT"><FONT COLOR="#64748B"><B>[PK, AI, NN]</B></FONT> <B>FILE_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">파일 번호</FONT></TD></TR>
        <TR><TD PORT="ORIG_NAME" ALIGN="LEFT"><B>ORIG_NAME</B> <FONT COLOR="#64748B">varchar(500)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">원본 파일명</FONT></TD></TR>
        <TR><TD PORT="STOR_NAME" ALIGN="LEFT"><B>STOR_NAME</B> <FONT COLOR="#64748B">varchar(500)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">서버 저장 파일명</FONT></TD></TR>
        <TR><TD PORT="FILE_PATH" ALIGN="LEFT"><FONT COLOR="#64748B"><B>[NN]</B></FONT> <B>FILE_PATH</B> <FONT COLOR="#64748B">text</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">파일 접근 경로</FONT></TD></TR>
        <TR><TD PORT="FILE_SIZE" ALIGN="LEFT"><B>FILE_SIZE</B> <FONT COLOR="#64748B">decimal(38,10)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">파일 크기 바이트</FONT></TD></TR>
        <TR><TD PORT="MIME_TYPE" ALIGN="LEFT"><B>MIME_TYPE</B> <FONT COLOR="#64748B">varchar(200)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">파일 MIME 유형</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><FONT COLOR="#64748B"><B>[NN]</B></FONT> <B>REGI_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시</FONT></TD></TR>
        <TR><TD PORT="REGI_USER" ALIGN="LEFT"><FONT COLOR="#64748B"><B>[FK]</B></FONT> <B>REGI_USER</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 사용자 번호</FONT></TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_administration {
    label="관리자 및 운영 콘텐츠";

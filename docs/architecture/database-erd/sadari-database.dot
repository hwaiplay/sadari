        <TR><TD PORT="RLES_CNTN" ALIGN="LEFT"><B>RLES_CNTN</B> <FONT COLOR="#64748B">varchar(1000)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">관리자 내부 해제 사유</FONT></TD></TR>
        <TR><TD PORT="REGI_ADMN" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>REGI_ADMN</B> <FONT COLOR="#64748B">decimal(19,0)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 관리자 번호 또는 아이디</FONT></TD></TR>
        <TR><TD PORT="RLES_ADMN" ALIGN="LEFT"><B>RLES_ADMN</B> <FONT COLOR="#64748B">decimal(19,0)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">해제 관리자 번호</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>REGI_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시</FONT></TD></TR>
        <TR><TD PORT="UPDT_ADMN" ALIGN="LEFT"><B>UPDT_ADMN</B> <FONT COLOR="#64748B">decimal(19,0)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 관리자 번호 또는 아이디</FONT></TD></TR>
        <TR><TD PORT="UPDT_DATE" ALIGN="LEFT"><B>UPDT_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 일시</FONT></TD></TR>
        <TR><TD PORT="SYNC_STAT" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>SYNC_STAT</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 상태 동기화 상태</FONT></TD></TR>

        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>회원 이용 정지 이력</I></FONT></TD></TR>
        <TR><TD PORT="SPND_NUMB" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[PK, NN]</B></FONT> <B>SPND_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">회원 정지 이력 번호</FONT></TD></TR>
        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">decimal(19,0)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 번호</FONT></TD></TR>
        <TR><TD PORT="PREV_STAT" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>PREV_STAT</B> <FONT COLOR="#64748B">varchar(30)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">처리 직전 사용자 상태</FONT></TD></TR>
        <TR><TD PORT="SPND_TYPE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>SPND_TYPE</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">회원 정지 유형</FONT></TD></TR>

        <TR><TD PORT="LOGN_NUMB" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[PK, AI, NN]</B></FONT> <B>LOGN_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">로그인 이력 번호</FONT></TD></TR>
        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[FK]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 번호</FONT></TD></TR>

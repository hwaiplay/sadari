        <TR><TD PORT="USER_NICK" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>USER_NICK</B> <FONT COLOR="#64748B">varchar(100)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 닉네임</FONT></TD></TR>
        <TR><TD PORT="USER_PROV" ALIGN="LEFT"><B>USER_PROV</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">로그인 제공자 코드</FONT></TD></TR>
        <TR><TD PORT="USER_ROLE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>USER_ROLE</B> <FONT COLOR="#64748B">varchar(30)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 권한 코드</FONT></TD></TR>
        <TR><TD PORT="INTR_CNTN" ALIGN="LEFT"><B>INTR_CNTN</B> <FONT COLOR="#64748B">varchar(1000)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">프로필 한줄소개</FONT></TD></TR>
        <TR><TD PORT="JOIN_DATE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>JOIN_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">회원 가입 일시</FONT></TD></TR>
        <TR><TD PORT="USER_CGRP" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[FK]</B></FONT> <B>USER_CGRP</B> <FONT COLOR="#64748B">varchar(10)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">USER_CGRP 업무 데이터</FONT></TD></TR>
        <TR><TD PORT="USER_STAT" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[FK, NN]</B></FONT> <B>USER_STAT</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 계정 상태</FONT></TD></TR>
        <TR><TD PORT="WTHD_DATE" ALIGN="LEFT"><B>WTHD_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">계정 비활성화 일시</FONT></TD></TR>
        <TR><TD PORT="DELT_DATE" ALIGN="LEFT"><B>DELT_DATE</B> <FONT COLOR="#64748B">datetime</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">삭제 예정 또는 처리 일시</FONT></TD></TR>
        <TR><TD PORT="ONBD_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>ONBD_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">온보딩 완료 여부</FONT></TD></TR>
      </TABLE>
    >];
    "TM_USSETX" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#0F766E" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TM_USSETX</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>회원별 서비스 설정</I></FONT></TD></TR>
        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[PK, FK, NN]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 번호</FONT></TD></TR>
        <TR><TD PORT="ENGL_YSNO" ALIGN="LEFT"><B>ENGL_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">영문 사용 여부</FONT></TD></TR>
        <TR><TD PORT="RSTA_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>RSTA_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독서 통계 공개 여부 &#183; DEFAULT &#39;N&#39;</FONT></TD></TR>
        <TR><TD PORT="GOAL_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>GOAL_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독서 목표 공개 여부 &#183; DEFAULT &#39;N&#39;</FONT></TD></TR>
        <TR><TD PORT="IMFD_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>IMFD_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사진 변경 피드 공개 여부 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="RPUB_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>RPUB_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신규 독후감 공개 기본값 &#183; DEFAULT &#39;N&#39;</FONT></TD></TR>
        <TR><TD PORT="LKAL_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>LKAL_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">좋아요 알림 사용 여부 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="RPAL_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>RPAL_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">댓글과 답글 알림 사용 여부 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="FOLL_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>FOLL_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">팔로우 알림 사용 여부 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="CLUB_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>CLUB_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">선택형 독서 모임 알림 사용 여부 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="CHAT_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>CHAT_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독서 모임 채팅 알림 사용 여부 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="RDUE_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>RDUE_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">독후감 목표 종료 알림 사용 여부 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="LKDF_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>LKDF_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신규 독후감 좋아요 알림 기본값 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="RPDF_YSNO" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>RPDF_YSNO</B> <FONT COLOR="#64748B">varchar(1)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신규 독후감 댓글 알림 기본값 &#183; DEFAULT &#39;Y&#39;</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>REGI_DATE</B> <FONT COLOR="#64748B">datetime(6)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시</FONT></TD></TR>
        <TR><TD PORT="UPDT_DATE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>UPDT_DATE</B> <FONT COLOR="#64748B">datetime(6)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">수정 일시</FONT></TD></TR>
      </TABLE>
    >];
    "TB_USVIEW" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#0F766E" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TB_USVIEW</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>사용자 콘텐츠 조회 이력</I></FONT></TD></TR>
        <TR><TD PORT="VIEW_TYPE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>VIEW_TYPE</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">조회 대상 유형</FONT></TD></TR>
        <TR><TD PORT="TAGT_NUMB" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>TAGT_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">조회 대상 번호</FONT></TD></TR>
        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[FK, NN]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 번호</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>REGI_DATE</B> <FONT COLOR="#64748B">datetime(6)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">최초 조회 일시</FONT></TD></TR>
      </TABLE>
    >];
    "TB_USINTR" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#0F766E" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TB_USINTR</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>회원 독서 관심분야</I></FONT></TD></TR>
        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[FK, NN]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">사용자 번호</FONT></TD></TR>
        <TR><TD PORT="INTR_CODE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>INTR_CODE</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">CATE_CODE 하위 관심분야 세부코드</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><FONT COLOR="#0F766E"><B>[NN]</B></FONT> <B>REGI_DATE</B> <FONT COLOR="#64748B">datetime(6)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시</FONT></TD></TR>

  subgraph cluster_support {
    label="신고 및 고객문의";
    color="#DC2626";
    penwidth=2;
    style="rounded,dashed";
    margin=24;
    "TH_CMEVDC" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#DC2626" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TH_CMEVDC</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>관리자 전용 신고 이미지 증거 원본</I></FONT></TD></TR>
        <TR><TD PORT="EVDC_NUMB" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[PK, AI, NN]</B></FONT> <B>EVDC_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신고 증거 번호</FONT></TD></TR>
        <TR><TD PORT="TAGT_TYPE" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[NN]</B></FONT> <B>TAGT_TYPE</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신고 대상 유형 세부코드</FONT></TD></TR>
        <TR><TD PORT="TAGT_NUMB" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[NN]</B></FONT> <B>TAGT_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신고 대상 번호</FONT></TD></TR>
        <TR><TD PORT="TAGT_HASH" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[NN]</B></FONT> <B>TAGT_HASH</B> <FONT COLOR="#64748B">char(64)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신고 대상 버전 SHA-256 해시</FONT></TD></TR>
        <TR><TD PORT="TAGT_USER" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[FK]</B></FONT> <B>TAGT_USER</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신고 대상 소유 사용자 번호</FONT></TD></TR>
        <TR><TD PORT="ORIG_NAME" ALIGN="LEFT"><B>ORIG_NAME</B> <FONT COLOR="#64748B">varchar(500)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">증거 원본 파일명</FONT></TD></TR>
        <TR><TD PORT="MIME_TYPE" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[NN]</B></FONT> <B>MIME_TYPE</B> <FONT COLOR="#64748B">varchar(200)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">증거 파일 MIME 유형</FONT></TD></TR>
        <TR><TD PORT="FILE_SIZE" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[NN]</B></FONT> <B>FILE_SIZE</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">증거 파일 크기 바이트</FONT></TD></TR>
        <TR><TD PORT="EVDC_DATA" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[NN]</B></FONT> <B>EVDC_DATA</B> <FONT COLOR="#64748B">longblob</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">비공개 신고 증거 원본 바이트</FONT></TD></TR>
        <TR><TD PORT="REGI_DATE" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[NN]</B></FONT> <B>REGI_DATE</B> <FONT COLOR="#64748B">datetime(6)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">등록 일시 &#183; DEFAULT CURRENT_TIMESTAMP(6)</FONT></TD></TR>
      </TABLE>
    >];
    "TH_CMPLNT" [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#CBD5E1" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#DC2626" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="14"><B>TH_CMPLNT</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT"><FONT COLOR="#334155" POINT-SIZE="10"><I>사용자 신고 접수와 처리 이력</I></FONT></TD></TR>
        <TR><TD PORT="CMPL_NUMB" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[PK, AI, NN]</B></FONT> <B>CMPL_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신고 번호</FONT></TD></TR>
        <TR><TD PORT="USER_NUMB" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[FK]</B></FONT> <B>USER_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신고자 사용자 번호</FONT></TD></TR>
        <TR><TD PORT="TAGT_TYPE" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[NN]</B></FONT> <B>TAGT_TYPE</B> <FONT COLOR="#64748B">varchar(20)</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신고 대상 유형 세부코드</FONT></TD></TR>
        <TR><TD PORT="TAGT_NUMB" ALIGN="LEFT"><FONT COLOR="#DC2626"><B>[NN]</B></FONT> <B>TAGT_NUMB</B> <FONT COLOR="#64748B">bigint</FONT><BR/><FONT COLOR="#475569" POINT-SIZE="9">신고 대상 번호</FONT></TD></TR>

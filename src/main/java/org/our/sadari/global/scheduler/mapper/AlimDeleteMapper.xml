<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.our.sadari.global.scheduler.mapper.AlimDeleteMapper">

    <!-- 사용자가 알림센터에서 지운 뒤 보존기간까지 지난 알림만 물리 삭제함 -->
    <delete id="delAlim">
        <bind name="commYes" value="@org.our.sadari.global.common.constant.Constant@COMM_YES" />
        DELETE /* delAlim */
         FROM TB_ALIMXX
         WHERE DELT_YSNO = #{commYes}
           AND COALESCE(UPDT_DATE, REGI_DATE) &lt; #{retentionDate}
    </delete>

</mapper>
